{
  "name": "@leak-doctor/shared",
  "version": "0.1.0",
  "description": "Zero-dependency shared memory diagnostic schemas, contracts, and formatters for leak-doctor.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "homepage": "https://leak-doctor-web.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmy-lana/leak-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/leak-doctor/issues"
  },
  "keywords": ["leak-doctor", "shared-types", "memory-schemas", "performance-formatters"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
