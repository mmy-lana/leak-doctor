{
  "name": "@leak-doctor/shared",
  "version": "0.2.3",
  "description": "Zero-dependency shared memory diagnostic schemas, contracts, and formatters for leak-doctor.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://leak-doctor-web.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmy-lana/leak-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/leak-doctor/issues"
  },
  "keywords": [
    "leak-doctor",
    "shared-types",
    "memory-schemas",
    "performance-formatters"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
