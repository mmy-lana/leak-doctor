{
  "name": "@leak-doctor/profiler",
  "version": "0.1.0",
  "description": "Core WeakRef and FinalizationRegistry memory profiling and detached DOM leak tracking engine.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "homepage": "https://leak-doctor-web.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmy-lana/leak-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/leak-doctor/issues"
  },
  "keywords": ["leak-doctor", "memory-leak", "detached-dom", "weakref", "finalizationregistry", "devtools", "react-19"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@leak-doctor/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
