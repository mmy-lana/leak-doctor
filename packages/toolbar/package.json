{
  "name": "@leak-doctor/toolbar",
  "version": "0.2.3",
  "description": "Zero-dependency Shadow DOM Web Component widget for live browser memory diagnostics.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://leak-doctor-web.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmy-lana/leak-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/leak-doctor/issues"
  },
  "keywords": [
    "leak-doctor",
    "web-component",
    "shadow-dom",
    "memory-toolbar",
    "heap-profiler"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@leak-doctor/profiler": "workspace:*",
    "@leak-doctor/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
